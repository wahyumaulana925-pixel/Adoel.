<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#09090B</item>
        <item name="postSplashScreenTheme">@style/AppTheme.Main</item>
    </style>

    <style name="AppTheme.Main" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:navigationBarColor">#09090B</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
</resources>
