<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- #1C1C1E matches DarkBg in Theme.kt (ui/theme) — kept in sync manually since this native
         splash/window background renders before Compose (and its DarkBg token) is available. -->
    <style name="AppTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#1C1C1E</item>
        <item name="postSplashScreenTheme">@style/AppTheme.Main</item>
    </style>

    <style name="AppTheme.Main" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#1C1C1E</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:navigationBarColor">#1C1C1E</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
</resources>
